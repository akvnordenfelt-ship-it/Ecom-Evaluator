# Local Streamlit secrets (never commit real keys — copy to secrets.toml)
# Streamlit Cloud: paste the same block in App settings → Secrets

GEMINI_API_KEY = "your_gemini_key_here"

# Authentication (required before free tier access)
AUTH_REQUIRED = "true"
AUTH_PROVIDER = "supabase"  # dev | supabase | streamlit_authenticator
FREE_EVALUATIONS_PER_ACCOUNT = "3"
QUOTA_BACKEND = "supabase"  # file (dev) | supabase (production)
GOOGLE_OAUTH_ENABLED = "true"

# Public app URL for OAuth redirect and email confirmation (no trailing slash)
# Local: http://localhost:8501
# Streamlit Cloud: https://your-app-name.streamlit.app
# Also add this exact URL in Supabase → Authentication → URL Configuration:
#   - Site URL (production app URL)
#   - Redirect URLs (same URL; wildcards like https://*.streamlit.app/** work)
AUTH_REDIRECT_URL = "http://localhost:8501"

# Supabase (when AUTH_PROVIDER = "supabase")
# Use the legacy anon public JWT — NOT sb_publishable_* or sb_secret_* for now.
# Supabase Dashboard → Project Settings → API → Legacy API Keys → anon (public)
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
#
# Confirm email must stay ON under Providers → Email.
# Custom SMTP is required for reliable delivery (Authentication → SMTP Settings).
# Email confirmation uses a 6-digit code. In Supabase → Authentication → Email Templates
# → Confirm signup, include {{ .Token }} in the body (not only a link).
# Example: "Your verification code is: {{ .Token }}"

# Optional rate limits for shared hosting (secondary guardrail)
MAX_ANALYSES_PER_SESSION = "3"
ANALYSIS_COOLDOWN_SECONDS = "45"
RATE_LIMIT_ENABLED = "true"

PAID_TIERS_ENABLED = "true"

# Stripe Checkout
# STRIPE_PREMIUM_CHECKOUT_URL = "https://buy.stripe.com/..."

# Streamlit Authenticator (when AUTH_PROVIDER = streamlit_authenticator)
# [authenticator]
# cookie_name = "productscore_auth"
# cookie_key = "replace-with-long-random-string"
# cookie_expiry_days = 30
#
# [authenticator.credentials.usernames.demo]
# email = "demo@example.com"
# name = "Demo User"
# password = "$2b$12$..."  # bcrypt hash from streamlit-authenticator Hasher
