# Copy this file to .env and add your keys (never commit .env)

# Required — all evaluation sections (Claude Haiku S1–2, Sonnet S3–6)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional model overrides
# CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6
# SECTION_API_DELAY_SECONDS=0.75

# Optional scraping fallback for Sections 5–6
# SCRAPER_PROVIDER=none
# SCRAPER_PROVIDER=apify
# APIFY_API_TOKEN=your_apify_token

# Optional — shared hosting rate limits
# MAX_ANALYSES_PER_SESSION=3
# ANALYSIS_COOLDOWN_SECONDS=45
# RATE_LIMIT_ENABLED=true
# PAID_TIERS_ENABLED=false

# Stripe Checkout link for the paywall
# STRIPE_PREMIUM_CHECKOUT_URL=https://buy.stripe.com/your_link
