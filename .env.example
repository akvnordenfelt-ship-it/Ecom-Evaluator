# Copy this file to .env and add your key (never commit .env)
GEMINI_API_KEY=your_gemini_key_here

# Optional model override
# GEMINI_MODEL=gemini-2.5-flash

# Optional — shared hosting rate limits (defaults shown)
# MAX_ANALYSES_PER_SESSION=3
# ANALYSIS_COOLDOWN_SECONDS=45
# RATE_LIMIT_ENABLED=true
# PAID_TIERS_ENABLED=false

# Stripe Checkout link for the paywall (optional until billing is live)
# STRIPE_PREMIUM_CHECKOUT_URL=https://buy.stripe.com/your_link
