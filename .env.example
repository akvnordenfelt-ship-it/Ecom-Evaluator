# Copy this file to .env and add your keys (never commit .env)

# Free tier — Sections 1–2 (Gemini Flash)
GEMINI_API_KEY=your_gemini_key_here

# Premium tier — Sections 3–6 (Claude Sonnet + Opus for CFO verdict)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6
# CLAUDE_OPUS_MODEL=claude-opus-4-8

# Optional scraping for Sections 5–6 (choose one provider)
# SCRAPER_PROVIDER=none
# SCRAPER_PROVIDER=apify
# APIFY_API_TOKEN=your_apify_token
# SCRAPER_PROVIDER=scraperapi
# SCRAPERAPI_KEY=your_scraperapi_key

# Optional — shared hosting rate limits (defaults shown)
# MAX_ANALYSES_PER_SESSION=3
# ANALYSIS_COOLDOWN_SECONDS=45
# RATE_LIMIT_ENABLED=true
# PAID_TIERS_ENABLED=false

# Stripe Checkout link for the paywall (optional until billing is live)
# STRIPE_PREMIUM_CHECKOUT_URL=https://buy.stripe.com/your_link
